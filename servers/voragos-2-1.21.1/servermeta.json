{
  "$schema": "file:///F:/AxolDev/voragos-repo/schemas/ServerMetaSchema.schema.json",
  "meta": {
    "version": "1.0.1",
    "name": "Voragos 2",
    "description": "Fantasía oscura medieval. Explora, sobrevive y conquista.",
    "icon": "",
    "address": "localhost:25565",
    "mainServer": true,
    "autoconnect": false,
    "javaOptions": {
      "ram": {
        "recommended": 6144,
        "minimum": 4096
      }
    }
  },
  "fabric": {
    "version": "0.19.5"
  },
  "untrackedFiles": [
    {
      "appliesTo": [
        "files"
      ],
      "patterns": [
        "options.txt",
        "config/*-client.*",
        "config/*.client.*",
        "config/sodium-options.json",
        "config/sodium-fingerprint.json",
        "config/sodium-mixins.properties",
        "config/iris.properties",
        "config/iris-excluded.json",
        "config/dynamic_fps.json",
        "config/fpsbooster.json",
        "config/gpu_booster_config.json",
        "config/lambdynlights.toml",
        "config/entity_model_features.json",
        "config/entity_texture_features.json",
        "config/entity_sound_features.json",
        "config/visuality.json",
        "emotes/**",
        "config/modmenu.json",
        "config/inventoryhud.json",
        "config/appleskin.json5",
        "config/dynamiccrosshair.json5",
        "config/cinematiczoom.json",
        "config/freecam.json5",
        "config/hold-my-items.json",
        "config/pingwheel.json",
        "config/emotecraft.json",
        "config/emotecraft_emote_map.json",
        "config/jei/**",
        "config/InventoryHUD/**",
        "config/crosshairs/**",
        "config/plasmovoice/**",
        "config/NoChatReports/**"
      ]
    }
  ]
}
